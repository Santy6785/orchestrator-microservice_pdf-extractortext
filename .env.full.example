# Variables de entorno para el microservicio Orquestador
# Nota: El Orquestador no tiene acceso a MongoDB. Toda persistencia se delega vía HTTP al microservicio de persistencia.

EXTRACTOR_SERVICE_URL=http://extractor
PERSISTENCE_SERVICE_URL=http://persistence:8000
LOG_LEVEL=INFO
EXTRACTOR_TIMEOUT_SECONDS=30
PERSISTENCE_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2

# Token opcional para proteger endpoints de control internos (/pause, /resume, /shutdown, /metrics, /trace).
# Si no se configura, se permite acceso desde hosts internos (loopback).
INTERNAL_CONTROL_TOKEN=
