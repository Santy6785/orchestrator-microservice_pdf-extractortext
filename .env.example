EXTRACTOR_SERVICE_URL=http://extractor
PERSISTENCE_SERVICE_URL=http://persistence:8000
LOG_LEVEL=INFO
EXTRACTOR_TIMEOUT_SECONDS=30
PERSISTENCE_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=2
# Entorno de ejecución: development, staging o production.
# En production es OBLIGATORIO definir INTERNAL_CONTROL_TOKEN; de lo contrario
# la app falla al arrancar.
ENVIRONMENT=development
# Token para proteger endpoints de control internos (/pause, /resume, /shutdown, /metrics, /trace).
# Si no se configura, solo se permite acceso desde hosts internos (loopback / clientes de prueba).
# En production este token es obligatorio y se exige para cualquier acceso externo al contenedor.
INTERNAL_CONTROL_TOKEN=
